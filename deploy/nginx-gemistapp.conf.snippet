# Paste into the nginx server block for gemistapp.zooq.app
# Embedded Shopify apps MUST be frameable by admin.shopify.com.
# Remove any existing: add_header X-Frame-Options DENY;

# Prefer Shopify app CSP (set by Node). Do not force DENY.
proxy_hide_header X-Frame-Options;
add_header X-Frame-Options "" always;

# If you use a shared ssl-params / security snippet that sets
#   add_header X-Frame-Options DENY;
# remove or comment that line for this vhost, then:
#   sudo nginx -t && sudo systemctl reload nginx
