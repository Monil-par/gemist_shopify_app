// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantCredential {
  id             String   @id @default(cuid())
  shop           String   @unique
  merchantKey    String
  merchantSecret String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MerchantSetting {
  id               String   @id @default(cuid())
  shop             String   @unique
  apiBaseUrl       String   @default("")
  markupPercent    Float    @default(0)
  appointmentUrl   String   @default("")
  appointmentEmail String   @default("")
  appointmentLabel String   @default("Schedule an Appointment")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GemistOrderSubmission {
  id               String   @id @default(cuid())
  shop             String
  shopifyOrderId   String
  shopifyOrderName String   @default("")
  gemistProductId  String   @default("")
  oemSku           String   @default("")
  gemistOrderId    String   @default("")
  status           String   @default("stored")
  error            String   @default("")
  payload          String   @default("")
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop, status])
}

/// License issued by the Gemist admin panel and activated for this shop.
model StoreLicense {
  id                  String    @id @default(cuid())
  shop                String    @unique
  licenseKey          String
  /// active | inactive | expired | revoked | suspended | pending | invalid
  status              String    @default("inactive")
  message             String    @default("")
  planCode            String    @default("")
  planName            String    @default("")
  planType            String    @default("")
  expiresAt           DateTime?
  lastVerifiedAt      DateTime?
  lastCheckAttemptAt  DateTime?
  lastError           String    @default("")
  verifyIntervalHours Int       @default(6)
  graceHours          Int       @default(72)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Last known Shopify app subscription for a shop (Billing API), read by storefront requests.
model StoreSubscription {
  id               String    @id @default(cuid())
  shop             String    @unique
  subscriptionId   String    @default("")
  planName         String    @default("")
  /// Shopify AppSubscriptionStatus (ACTIVE, PENDING, CANCELLED, DECLINED, EXPIRED, FROZEN) or NONE
  status           String    @default("NONE")
  test             Boolean   @default(false)
  trialDays        Int       @default(0)
  currentPeriodEnd DateTime?
  lastCheckedAt    DateTime?
  lastError        String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Per-shop storefront visibility for a Gemist style (slug).
/// Missing row = active (shown on storefront).
model MerchantCatalogStyle {
  id              String   @id @default(cuid())
  shop            String
  slug            String
  status          String   @default("active") // active | archived | deleted
  title           String   @default("")
  gemistProductId String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, slug])
  @@index([shop, status])
}

/// Specificity-based markup rule (SOW 3.7). Most matching conditions wins.
/// conditionsJson: [{"optionType":"Metal Type","optionValue":"Natural Diamond"}, ...]
model MarkupRule {
  id             String   @id @default(cuid())
  shop           String
  name           String   @default("")
  /// Absolute price multiplier, e.g. 2.5 = 2.5× Gemist price.
  multiplier     Float
  conditionsJson String   @default("[]")
  /// Cached condition count for sorting; kept in sync on write.
  specificity    Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop, active])
  @@index([shop, specificity])
}
