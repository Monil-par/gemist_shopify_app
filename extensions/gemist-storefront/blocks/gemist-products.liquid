{%- liquid
  assign heading = block.settings.heading
  assign limit = block.settings.limit
  assign columns = block.settings.columns
  assign api_base = block.settings.api_base_url | strip
  assign block_id = 'gemist-products-' | append: block.id
-%}

{% render 'gemist-widget-vars' %}
{% render 'gemist-fonts' %}

<style>
  html {
    --gemist-list-bg: {{ block.settings.background }};
    --gemist-detail-bg: {{ block.settings.detail_background }};
    --gemist-designer-bg: {{ block.settings.designer_background }};
  }

  #{{ block_id }},
  #{{ block_id }} [data-gemist-catalog],
  #{{ block_id }} [data-gemist-detail],
  #{{ block_id }} [data-gemist-designer-page] {
    --gemist-cols: {{ columns }} !important;
    --gemist-list-bg: {{ block.settings.background }} !important;
    --gemist-detail-bg: {{ block.settings.detail_background }} !important;
    --gemist-designer-bg: {{ block.settings.designer_background }} !important;
    --gemist-setting-bg: {{ block.settings.background }} !important;
    --gemist-setting-text: {{ block.settings.text_color }} !important;
    --gemist-setting-accent: {{ block.settings.accent_color }} !important;
    --gemist-bg: {{ block.settings.background }} !important;
    --gemist-text: {{ block.settings.text_color }} !important;
    --gemist-accent: {{ block.settings.accent_color }} !important;
    --gemist-setting-radius: 0 !important;
    --gemist-radius: 0 !important;
    --gemist-gap: {{ block.settings.grid_gap }}px !important;
    --gemist-section-padding: {{ block.settings.section_padding }}px !important;
    --gemist-heading-size: {{ block.settings.heading_size }}px !important;
    --gemist-heading-color: {{ block.settings.heading_color }} !important;
    --gemist-heading-margin: 0.65rem !important;
    --gemist-title-size: {{ block.settings.title_size }}px !important;
    --gemist-title-color: {{ block.settings.title_color }} !important;
    --gemist-body-size: {{ block.settings.description_size }}px !important;
    --gemist-body-color: {{ block.settings.description_color }} !important;
    --gemist-price-size: {{ block.settings.price_size }}px !important;
    --gemist-price-color: {{ block.settings.price_color }} !important;
    {%- if block.settings.image_ratio == 'auto' -%}
    --gemist-image-size: 224px !important;
    --gemist-image-ratio: auto !important;
    {%- else -%}
    --gemist-image-size: auto !important;
    --gemist-image-ratio: {{ block.settings.image_ratio }} !important;
    {%- endif -%}
    --gemist-image-radius: 0 !important;
    --gemist-image-fit: {{ block.settings.image_fit }} !important;
    --gemist-pager-font-size: {{ block.settings.pager_font_size }}px !important;
    --gemist-pager-btn-size: {{ block.settings.pager_btn_size }}px !important;
    --gemist-pager-active: {{ block.settings.pager_active_color }} !important;
    --gemist-pager-inactive: {{ block.settings.pager_inactive_color }} !important;
    --gemist-pager-prev-bg: {{ block.settings.pager_prev_bg }} !important;
    --gemist-pager-next-bg: {{ block.settings.pager_next_bg }} !important;
    --gemist-pager-icon: #ffffff !important;
    --gemist-pager-align: {{ block.settings.pager_align }} !important;
    --gemist-action-font-size: {{ block.settings.action_font_size }}px !important;
    --gemist-view-btn-bg: {{ block.settings.view_btn_bg }} !important;
    --gemist-view-btn-text: {{ block.settings.view_btn_text }} !important;
    --gemist-customize-btn-bg: {{ block.settings.customize_btn_bg }} !important;
    --gemist-customize-btn-text: {{ block.settings.customize_btn_text }} !important;
  }

  #{{ block_id }} [data-gemist-catalog] {
    --gemist-lux-bg: {{ block.settings.background }} !important;
    background: {{ block.settings.background }} !important;
  }

  #{{ block_id }} [data-gemist-detail] {
    --gemist-lux-bg: {{ block.settings.detail_background }} !important;
    background: {{ block.settings.detail_background }} !important;
  }

  #{{ block_id }} [data-gemist-designer-page] {
    --gemist-lux-bg: {{ block.settings.designer_background }} !important;
    background: {{ block.settings.designer_background }} !important;
  }

  .gemist-products-block,
  #{{ block_id }} {
    background: var(--gemist-list-bg, {{ block.settings.background }}) !important;
    width: 100% !important;
    max-width: none !important;
    min-height: 100vh !important;
  }

  html.gemist-catalog-open,
  body.gemist-catalog-open {
    background: var(--gemist-list-bg, {{ block.settings.background }}) !important;
  }

  html.gemist-detail-open,
  body.gemist-detail-open {
    background: var(--gemist-detail-bg, {{ block.settings.detail_background }}) !important;
  }

  html.gemist-detail-open #{{ block_id }},
  html.gemist-detail-open .gemist-products-block,
  html.gemist-detail-open #{{ block_id }} [data-gemist-detail] {
    background: var(--gemist-detail-bg, {{ block.settings.detail_background }}) !important;
  }

  html.gemist-designer-open,
  body.gemist-designer-open {
    background: var(--gemist-designer-bg, {{ block.settings.designer_background }}) !important;
  }

  html.gemist-designer-open #{{ block_id }},
  html.gemist-designer-open .gemist-products-block,
  html.gemist-designer-open #{{ block_id }} [data-gemist-designer-page] {
    background: var(--gemist-designer-bg, {{ block.settings.designer_background }}) !important;
  }

  html.gemist-catalog-open #{{ block_id }},
  html.gemist-catalog-open .gemist-products-block,
  html.gemist-catalog-open #{{ block_id }} [data-gemist-catalog] {
    background: var(--gemist-list-bg, {{ block.settings.background }}) !important;
  }

  @media (max-width: 749px) {
    #{{ block_id }},
    .gemist-products-block,
    .shopify-section:has(#{{ block_id }}) {
      --gemist-section-padding: 0 !important;
      padding: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    #{{ block_id }} [data-gemist-catalog],
    #{{ block_id }} [data-gemist-detail],
    #{{ block_id }} [data-gemist-designer-page] {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }
</style>

<section
  id="{{ block_id }}"
  class="gemist-products gemist-products--cols-{{ columns }}"
  style="
    --gemist-cols: {{ columns }};
    --gemist-setting-bg: {{ block.settings.background }};
    --gemist-setting-text: {{ block.settings.text_color }};
    --gemist-setting-accent: {{ block.settings.accent_color }};
    --gemist-setting-radius: 0px;
    --gemist-bg: {{ block.settings.background }};
    --gemist-text: {{ block.settings.text_color }};
    --gemist-accent: {{ block.settings.accent_color }};
    --gemist-radius: 0px;
  "
  data-gemist-products
  data-app-src="{{ 'gemist-app.js' | asset_url }}"
  data-api-base="{{ api_base | default: 'https://classique.dev.gemist.co' | escape }}"
  data-limit="{{ limit }}"
  data-show-heading="{{ block.settings.show_heading }}"
  data-show-title="{{ block.settings.show_title }}"
  data-show-description="true"
  data-show-price="{{ block.settings.show_price }}"
  data-show-actions="{{ block.settings.show_actions }}"
  data-view-label="{{ block.settings.view_btn_label | escape }}"
  data-card-customize-label="{{ block.settings.customize_btn_label | escape }}"
  data-show-filters="true"
  data-empty-label="{{ 'gemist.products.empty' | t | escape }}"
  data-error-label="{{ 'gemist.products.error' | t | escape }}"
  data-retry-label="{{ 'gemist.products.retry' | t | escape }}"
  data-rotate-label="{{ 'gemist.products.rotate' | t | escape }}"
  data-back-label="{{ 'gemist.products.back' | t | escape }}"
  data-back-product-label="{{ 'gemist.products.back_product' | t | escape }}"
  data-prev-label="{{ 'gemist.products.prev' | t | escape }}"
  data-next-label="{{ 'gemist.products.next' | t | escape }}"
  data-page-label="{{ 'gemist.products.page' | t | escape }}"
  data-add-label="{{ 'gemist.products.add_to_cart' | t | escape }}"
  data-adding-label="{{ 'gemist.products.adding' | t | escape }}"
  data-cart-error-label="{{ 'gemist.products.cart_error' | t | escape }}"
  data-customize-label="{{ 'gemist.products.customize' | t | escape }}"
  data-designer-label="{{ 'gemist.products.designer' | t | escape }}"
  data-designer-title="{{ 'gemist.products.designer_title' | t | escape }}"
  data-designer-path="{{ block.settings.designer_path | default: 'designer/bands' | escape }}"
  data-designer-default-shape="Asscher"
  data-appointment-label="{{ 'gemist.products.appointment' | t | escape }}"
  data-appointment-missing="{{ 'gemist.products.appointment_missing' | t | escape }}"
  data-engraving-label="{{ 'gemist.products.engraving' | t | escape }}"
  data-engraving-placeholder="{{ 'gemist.products.engraving_placeholder' | t | escape }}"
  data-engraving-none-label="{{ 'gemist.products.engraving_none' | t | escape }}"
  data-engraving-add-label="{{ 'gemist.products.engraving_add' | t | escape }}"
  data-engraving-text-label="{{ 'gemist.products.engraving_text' | t | escape }}"
  data-engraving-required="{{ 'gemist.products.engraving_required' | t | escape }}"
  data-engraving-invalid="{{ 'gemist.products.engraving_invalid' | t | escape }}"
  data-engraving-price-note="{{ 'gemist.products.engraving_price_note' | t | escape }}"
  data-engraving-font-label="{{ 'gemist.products.engraving_font' | t | escape }}"
  data-engraving-preview-label="{{ 'gemist.products.engraving_preview' | t | escape }}"
  data-engraving-preview-note="{{ 'gemist.products.engraving_preview_note' | t | escape }}"
  data-engraving-max-chars="20"
  data-engraving-fonts="Classic|Serif|Script|Modern"
  data-engraving-fee="50"
  data-gemist-id-label="{{ 'gemist.products.gemist_id' | t | escape }}"
  data-config-id-label="{{ 'gemist.products.config_id' | t | escape }}"
  data-oem-sku-label="{{ 'gemist.products.oem_sku' | t | escape }}"
  data-specs-label="{{ 'gemist.products.specs_heading' | t | escape }}"
  data-meta-label="{{ 'gemist.products.meta_heading' | t | escape }}"
>
  <div data-gemist-catalog>
    <script>
      if (/[?&](id|slug|product|productId)=/i.test(window.location.search)) {
        document.currentScript.parentElement.hidden = true;
      }
    </script>
    {%- if block.settings.show_heading and heading != blank -%}
      <h2 class="gemist-products__heading">{{ heading | escape }}</h2>
    {%- endif -%}

    <div class="gemist-catalog__layout">
      <aside class="gemist-catalog__filters" data-gemist-filters aria-label="Product filters"></aside>
      <div class="gemist-catalog__main">
        <p class="gemist-products__status" data-gemist-products-status>
          <span class="gemist-spinner"></span>
          <span class="gemist-status-text">{{ 'gemist.products.loading' | t }}</span>
        </p>
        <ul class="gemist-products__grid" data-gemist-products-grid hidden></ul>
        <nav class="gemist-products__pager" data-gemist-products-pager hidden aria-label="{{ 'gemist.products.pagination' | t | escape }}"></nav>
      </div>
    </div>
  </div>

  <article class="gemist-detail" data-gemist-detail hidden></article>
  <article class="gemist-designer-page" data-gemist-designer-page hidden></article>
</section>

{% schema %}
{
  "name": "Product grid",
  "target": "section",
  "class": "gemist-products-block",
  "stylesheet": "gemist-storefront.css",
  "javascript": "gemist-products.js",
  "enabled_on": {
    "templates": ["index", "collection", "page", "product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content & layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All products"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show product title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_actions",
      "label": "Show View / Customize buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "view_btn_label",
      "label": "View product button label",
      "default": "View product"
    },
    {
      "type": "text",
      "id": "customize_btn_label",
      "label": "Customize button label",
      "default": "Customize"
    },
    {
      "type": "text",
      "id": "api_base_url",
      "label": "Gemist API URL (optional override)",
      "default": "https://classique.dev.gemist.co",
      "info": "Gemist catalog host only. Do not put your Shopify app URL here."
    },
    {
      "type": "text",
      "id": "designer_path",
      "label": "Designer path",
      "default": "designer/bands",
      "info": "Appended to the Gemist API URL for the customize iframe."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 1,
      "max": 100,
      "step": 1,
      "label": "Products per page",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 24
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 34
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#6b6b6b"
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 18
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#c9a882"
    },

    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "auto", "label": "Auto" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "contain"
    },

    {
      "type": "header",
      "content": "Card buttons"
    },
    {
      "type": "range",
      "id": "action_font_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "view_btn_bg",
      "label": "View button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "view_btn_text",
      "label": "View button text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "customize_btn_bg",
      "label": "Customize button background",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "customize_btn_text",
      "label": "Customize button text",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Pagination"
    },
    {
      "type": "range",
      "id": "pager_font_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Page number size",
      "default": 18
    },
    {
      "type": "range",
      "id": "pager_btn_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Arrow button size",
      "default": 44
    },
    {
      "type": "color",
      "id": "pager_active_color",
      "label": "Active page number",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "pager_inactive_color",
      "label": "Inactive page number",
      "default": "#c5c5c8"
    },
    {
      "type": "color",
      "id": "pager_prev_bg",
      "label": "Previous button background",
      "default": "#c5c5c8"
    },
    {
      "type": "color",
      "id": "pager_next_bg",
      "label": "Next button background",
      "default": "#1a1a2e"
    },
    {
      "type": "select",
      "id": "pager_align",
      "label": "Pagination alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Product list background",
      "default": "#f6f4ef"
    },
    {
      "type": "color",
      "id": "detail_background",
      "label": "Product page background",
      "default": "#f6f4ef"
    },
    {
      "type": "color",
      "id": "designer_background",
      "label": "Customize page background",
      "default": "#f6f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c9a882"
    }
  ]
}
{% endschema %}
